# Abhängigkeiten und Build-Artefakte — pro Stack anpassen/ergänzen
node_modules/
dist/
build/
out/
.next/
coverage/
*.tsbuildinfo
*.log

# Umgebungsvariablen — nie committen
.env
.env.local
.env.*.local

# Persönliche Freigaben — trägt Freigaben, die nie reviewt werden.
# MUSS ignoriert bleiben (siehe SETUP.md Punkt 7 / Befund G10).
.claude/settings.local.json

# Aufgaben-Gedächtnis — bewusst nicht committet, nur die Vorlage bleibt
# getrackt (state/zwischenstand/VORLAGE.md via Ausnahme unten).
state/zwischenstand/*.md
!state/zwischenstand/VORLAGE.md

# Editor-/OS-Artefakte
.DS_Store
Thumbs.db

# Checkpoint-Store-Tests (F1) — Wegwerfverzeichnis, kein Produktzustand.
# Räumt sich in jedem Testfall selbst auf; Eintrag hier nur als Netz für
# einen abgebrochenen Testlauf.
kontrollzustand-test/

# Rohereignisstrom des Claude-Code-Gateways (F6a WS2, E-190) — rohe
# stdout/stderr-Bytes je Lauf, nie committet. Aus der Laufakte
# ausschließlich über ihren Inhalts-Hash referenziert.
kontrollzustand-roh/

# Scratch-Zielordner für scripts/verify-f6b-ws-g-schreiblauf.mjs (F6b
# WS-G, Option A, 03.09.2026) — reale Schreibwirkung eines echten
# Claude-Code-Laufs, kein Produktzustand. Kein chdir mehr (Option A:
# process.cwd() muss das reale Repo bleiben, damit arbeitsverzeichnis_pfad
# zum committeten Wirksamkeitsnachweis passt) — die Schreibwirkung wird
# stattdessen hierher umgeleitet statt über einen Prozessumzug.
scratch-f6b-ws-g/

# Programm-Ebene — Basislinie und Erfolgskriterium der vier Beteiligten.
# Personenbezogen, gehört nicht in ein öffentliches Vorlagen-Repo und
# nicht in einen abgeleiteten Projekt-Klon. Zieht in Phase 3 in das
# Lern-Repo (Befund P4).
programm/
