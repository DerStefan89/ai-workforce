{
  "url": "http://127.0.0.1:4291/#/einstellungen",
  "viewport": {
    "breite": 1440,
    "hoehe": 1000
  },
  "localStorageSetzen": {
    "leitstand-theme": "sepia",
    "leitstand-sprache": "xx"
  },
  "beobachtete": {
    "texte": [
      {
        "name": "Ansicht",
        "selector": "[data-view]:not([hidden])",
        "attribut": "data-view"
      },
      {
        "name": "data-theme",
        "selector": "html",
        "attribut": "data-theme"
      },
      {
        "name": "lang",
        "selector": "html",
        "attribut": "lang"
      },
      {
        "name": "theme-color",
        "selector": "meta[name=\"theme-color\"]",
        "attribut": "content"
      },
      {
        "name": "Titel",
        "selector": "#view-einstellungen h1"
      }
    ]
  },
  "schritte": [
    {
      "label": "Speicher: Theme „sepia“, Sprache „xx“"
    }
  ]
}
