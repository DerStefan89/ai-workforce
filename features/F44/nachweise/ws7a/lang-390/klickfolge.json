  "schritte": [
    {
      "label": "Lange Namen/Beschreibungen/IDs bei 390 px: kein waagerechter Scroll",
      "warteAufSelector": {
        "selector": "#capabilities-library .werkzeug-karte",
        "timeoutMs": 15000
      },
      "screenshot": "d390-lang-1-kacheln.webp"
    },
    {
      "label": "Detail der langen Kachel offen; Technik-Klappe mit langem Pfad",
      "klick": "#capabilities-library .werkzeug-detail > summary",
      "warteAufSelector": {
        "selector": ".werkzeug-detail[open] dl",
        "timeoutMs": 15000
      }
    },
    {
      "label": "Technik-Klappe offen",
      "klick": ".werkstatt-technik > summary",
