  "beobachtete": {
    "texte": [
      {
        "name": "Ansicht",
        "selector": "[data-view]:not([hidden])",
        "attribut": "data-view"
      },
      {
        "name": "Nav aktuell",
        "selector": "[aria-current=\"page\"]",
        "attribut": "data-nav-view"
      },
      {
        "name": "data-theme",
        "selector": "html",
        "attribut": "data-theme"
      },
      {
        "name": "lang",
        "selector": "html",
        "attribut": "lang"
      },
      {
        "name": "Fokus",
        "selector": ":focus",
        "attribut": "id"
      },
      {
        "name": "Blase aria-expanded",
        "selector": "#chat-blase",
        "attribut": "aria-expanded"
      },
      {
        "name": "Kopfknopf aria-expanded",
        "selector": "#chat-umschalter",
        "attribut": "aria-expanded"
      },
      {
        "name": "Reiter gewählt",
        "selector": "#chat-register [aria-selected=\"true\"]"
      },
      {
        "name": "Seitentitel",
        "selector": "#chat-seitentitel"
      },
      {
        "name": "Dock-Titel",
        "selector": "#chat-titel"
      },
      {
        "name": "Fehler",
        "selector": "#chat-fehler:not([hidden])"
      },
      {
        "name": "Dock-Projekt",
        "selector": "#chat-dock-projekt"
      },
      {
        "name": "Kontext-Projekt",
        "selector": "#chat-kontext-projekt"
      }
    ],
    "sichtbarkeit": [
      {
        "name": "Dock/Ansicht sichtbar",
        "id": "shell-chat-spalte"
      },
      {
        "name": "Blase sichtbar",
        "id": "chat-blase"
      },
      {
        "name": "Leerzustand",
        "id": "chat-leer"
      },
      {
        "name": "Abbrechen sichtbar",
        "id": "chat-abbrechen-btn"
      },
      {
        "name": "Untermodus sichtbar",
        "id": "chat-untermodus-auswahl"
      }
    ],
    "vorhanden": [
      {
        "name": "große Ansicht",
        "selector": "#shell.chat-gross #shell-chat-spalte.chat-grossansicht"
      },
      {
        "name": "Verkleinern sichtbar",
        "selector": "#shell-chat-spalte.chat-grossansicht:not([hidden]) #chat-verkleinern"
      },
      {
        "name": "Eingabe leer",
        "selector": "#chat-eingabe:placeholder-shown"
      },
      {
        "name": "Nutzerblase",
        "selector": ".chat-bubble-reihe-nutzer"
      },
      {
        "name": "Tippanzeige",
        "selector": ".chat-tippindikator"
      },
      {
        "name": "Senden gesperrt",
        "selector": "#chat-senden[disabled]"
      },
      {
        "name": "„Als Auftrag anlegen“",
        "selector": ".chat-auftrag-oeffnen-btn"
      },
      {
        "name": "javascript:-Link (muss fehlen)",
        "selector": "#view-chat a[href^=\"javascript\"]"
      }
    ],
    "ueberlauf": true
  },
  "schritte": [
    {
      "label": "Start: Lauf-Detail #/runs/<id> des Projekts AI Workforce (wird als Rückkehrziel gemerkt)",
      "warteAufSelector": {
        "selector": "#chat-blase",
        "timeoutMs": 8000
      }
    },
    {
      "label": "„Frag Jarvis“ öffnet das Dock; „↗“ → #/chat",
      "klick": "#chat-umschalter"
    },
    {
      "label": "„↗“ → #/chat",
      "klick": "#chat-gross-oeffnen",
      "warteAufSelector": {
        "selector": ".chat-grossansicht #chat-seitentitel",
        "timeoutMs": 8000
      }
    },
    {
      "label": "Projektwechsel im Kopf auf „Zweites Projekt“ (fester leerer Verlauf): Kontext und Verlauf zeigen das neue Projekt",
      "anfragenAntworten": [
        {
          "muster": "**/chat",
          "methode": "GET",
          "json": {
            "verlauf": []
          }
        },
        {
          "muster": "**/sparring",
          "methode": "GET",
          "json": {
            "verlauf": []
          }
        }
      ],
      "auswaehlen": {
        "selector": "#kopf-projekt-auswahl",
        "wert": "zweites-projekt"
      },
      "warteAufSelector": {
        "selector": "#chat-leer-jarvis",
        "timeoutMs": 8000
      },
      "screenshot": "p1-gross-nach-wechsel.webp"
    },
    {
      "label": "„Gespräch verkleinern“ → Liste #/ausfuehrungen statt des Details des alten Projekts, Dock offen mit „Zweites Projekt“",
      "klick": "#chat-verkleinern",
      "warteAufSelector": {
        "selector": "#shell-chat-spalte:not(.chat-grossansicht)",
        "timeoutMs": 8000
      },
      "screenshot": "p2-verkleinert-liste.webp"
    }
  ]
}
