      },
      {
        "name": "Fehlerzeile",
        "selector": "#auftrag-anlegen-fehler"
      }
    ],
    "vorhanden": [
      {
        "name": "Hinweis amber",
        "selector": ".abnahme-umfang.note.amber"
      },
      {
        "name": "Abnehmen",
        "selector": "#workflow-entscheidung input[type=\"radio\"][value=\"ANGENOMMEN\"]"
      },
      {
        "name": "Bereiche aufgeklappt",
        "selector": "#auftrag-bereiche-bereich[open]"
      },
      {
        "name": "Fehlerzeile sichtbar",
        "selector": "#auftrag-anlegen-fehler:not([hidden])"
      }
    ],
    "ueberlauf": true
  },
  "schritte": [
    {
      "label": "Titel und Ergebnis",
      "warteAufSelector": {
        "selector": "#auftrag-titel",
        "timeoutMs": 10000
      },
      "tippen": {
        "selector": "#auftrag-titel",
        "text": "CSV-Export"
      }
    },
    {
      "label": "Ergebnis",
      "tippen": {
        "selector": "#auftrag-auftragstext",
        "text": "Füge einen CSV-Export hinzu."
      }
    },
    {
      "label": "Bereiche aufklappen",
      "klick": "#auftrag-bereiche-bereich > summary"
    },
    {
      "label": "Absoluter Pfad, „Ablauf vorbereiten“ ⇒ Fehlerzeile",
      "tippen": {
        "selector": "#auftrag-bereiche",
        "text": "src/export/\n/etc/"
      },
      "klick": "#auftrag-ablauf-vorbereiten",
      "warteAufSelector": {
        "selector": "#auftrag-anlegen-fehler:not([hidden])",
        "timeoutMs": 5000
      },
      "screenshot": "01-fehler.webp"
    }
  ]
