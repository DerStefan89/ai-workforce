{
  "url": "http://127.0.0.1:4199/#/dashboard",
  "viewport": {
    "breite": 1440,
    "hoehe": 900
  },
  "farbschema": "light",
  "screenshotQualitaet": 0.8,
  "localStorageSetzen": {
    "leitstand-chat-offen": "true",
    "leitstand-chat-modus": "jarvis",
    "leitstand-chat-sparring-untermodus": "feature"
  },
  "anfragenAntworten": [
    {
      "muster": "**/api/zustand",
      "methode": "GET",
      "status": 200,
      "json": {
        "laeufe": [],
        "startfehler": [],
        "workflows": [],
        "fehler": [],
        "aktiverLauf": {
          "aktiv": false,
          "laufId": null
        },
        "pruefbefehl": null,
        "istAiWorkforce": true,
        "startHinweis": null
      }
    },
    {
      "muster": "**/api/roadmap",
      "methode": "GET",
      "status": 200,
      "json": {
        "status": "ok",
        "vision": "Eine ruhige Kommandozentrale für die Zusammenarbeit mit KI.",
        "meilensteine": []
      }
    },
    {
      "muster": "**/api/projekte",
      "methode": "GET",
      "status": 200,
      "json": {
        "projekte": [
          {
            "id": "ai-workforce",
            "name": "AI Workforce",
            "repo_pfad": "C:/Projekte/ai-workforce",
            "status": "IN_ENTWICKLUNG",
            "laufAktiv": false
          }
        ]
      }
    },
    {
      "muster": "**/chat",
      "methode": "GET",
      "status": 200,
      "json": {
        "verlauf": [
          {
            "laufId": "jarvis-alt-1",
            "nachricht": "Wo steht mein Projekt?",
            "jarvisAntwort": {
              "art": "antwort",
              "antwort": "F45 B0 ist in Arbeit."
            },
            "istZusammenfassung": false,
            "istFehler": false,
            "fehler": null
          },
          {
            "laufId": "jarvis-alt-2",
            "nachricht": "Fasse bitte alle Findings zusammen.",
            "jarvisAntwort": {
              "art": "antwort",
              "antwort": "Lauf an der Zeitgrenze (180 s) beendet — keine Antwort."
            },
            "istZusammenfassung": false,
            "istFehler": true,
            "fehler": {
              "art": "zeitgrenze",
              "grund": null,
              "zeitgrenzeMs": 180000
            }
          }
        ]
      }
    },
    {
      "muster": "**/sparring",
      "methode": "GET",
      "status": 200,
      "json": {
        "verlauf": []
      }
    }
  ],
  "beobachtete": {
    "texte": [
      {
        "name": "lang",
        "selector": "html",
        "attribut": "lang"
      },
      {
        "name": "Letzte Antwort-Blase",
        "selector": "#chat-verlauf .chat-bubble-reihe-jarvis:last-of-type .chat-bubble"
      },
      {
        "name": "Band oben",
        "selector": "#start-hinweis"
      },
      {
        "name": "Hinweis im Chat",
        "selector": "#chat-start-hinweis"
      },
      {
        "name": "Sperrgrund",
        "selector": "#chat-sperrgrund"
      },
      {
        "name": "Reiter Jarvis aria-label",
        "selector": "#chat-modus-jarvis-btn",
        "attribut": "aria-label"
      },
      {
        "name": "Senden disabled",
        "selector": "#chat-senden",
        "attribut": "disabled"
      }
    ],
    "sichtbarkeit": [
      {
        "name": "Band oben sichtbar",
        "id": "start-hinweis"
      },
      {
        "name": "Hinweis im Chat sichtbar",
        "id": "chat-start-hinweis"
      },
      {
        "name": "Sperrgrund sichtbar",
        "id": "chat-sperrgrund"
      },
      {
        "name": "„Lauf abbrechen“",
        "id": "chat-abbrechen-btn"
      }
    ],
    "vorhanden": [
      {
        "name": "Fehler-Eintrag",
        "selector": "#chat-verlauf [data-eintrag-art=\"fehler\"]"
      },
      {
        "name": "zwei Fehler-Einträge (darf nicht)",
        "selector": "#chat-verlauf [data-eintrag-art=\"fehler\"] ~ [data-eintrag-art=\"fehler\"]"
      },
      {
        "name": "Tipp-Punkte",
        "selector": "#chat-verlauf .chat-tippindikator"
      },
      {
        "name": "Punkt am Reiter Jarvis",
        "selector": "#chat-modus-jarvis-btn.hat-neue-antwort"
      },
      {
        "name": "Punkt am Untermodus Projekt",
        "selector": "#chat-untermodus-projekt-btn.hat-neue-antwort"
      },
      {
        "name": "Untermodus-Hinweis",
        "selector": "#chat-verlauf .chat-untermodus-hinweis"
      },
      {
        "name": "Auftrag-Brücke an Fehler (darf nicht)",
        "selector": "[data-eintrag-art=\"fehler\"] .chat-auftrag-oeffnen-btn"
      },
      {
        "name": "aria-live außer Persona (darf nicht)",
        "selector": "[aria-live]:not(#persona-text-status)"
      }
    ]
  },
  "schritte": [
    {
      "label": "Verlauf mit einem Server-Fehler-Eintrag (Zeitgrenze 180 s): „Lauf nicht erfolgreich“, Grund, keine Auftrag-Brücke",
      "warteAufSelector": {
        "selector": "#chat-verlauf [data-eintrag-art=\"fehler\"]",
        "timeoutMs": 8000
      },
      "screenshot": "01-fehler-eintrag.webp"
    }
  ]
}
