{
  "url": "http://127.0.0.1:4199/#/chat",
  "viewport": {
    "breite": 1440,
    "hoehe": 900
  },
  "farbschema": "dark",
  "screenshotQualitaet": 0.8,
  "localStorageSetzen": {
    "leitstand-chat-offen": "true",
    "leitstand-chat-modus": "jarvis",
    "leitstand-sprache": "en"
  },
  "anfragenAntworten": [
    {
      "muster": "**/api/zustand",
      "methode": "GET",
      "status": 200,
      "json": {
        "laeufe": [],
        "startfehler": [],
