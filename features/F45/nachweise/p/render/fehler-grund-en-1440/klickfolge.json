  "beobachtete": {
    "texte": [
      {
        "name": "lang",
        "selector": "html",
        "attribut": "lang"
      },
      {
        "name": "Sperrgrund",
        "selector": "#chat-sperrgrund"
      },
      {
        "name": "Senden disabled",
        "selector": "#chat-senden",
        "attribut": "disabled"
      },
      {
        "name": "Senden title",
        "selector": "#chat-senden",
        "attribut": "title"
      },
      {
        "name": "Zusammenfassen disabled",
        "selector": "#chat-zusammenfassen-btn",
        "attribut": "disabled"
      },
      {
        "name": "Fehlerzeile",
        "selector": "#chat-fehler"
      },
      {
        "name": "Letzter Fehler-Eintrag",
        "selector": "#chat-verlauf [data-eintrag-art=\"fehler\"]:last-of-type .chat-bubble"
      }
    ],
    "sichtbarkeit": [
      {
        "name": "Sperrgrund sichtbar",
        "id": "chat-sperrgrund"
      },
      {
        "name": "Fehlerzeile sichtbar",
        "id": "chat-fehler"
      }
    ],
    "vorhanden": [
      {
        "name": "Fehler-Eintrag",
        "selector": "#chat-verlauf [data-eintrag-art=\"fehler\"]"
      },
      {
        "name": "Tipp-Punkte",
        "selector": "#chat-verlauf .chat-tippindikator"
      }
    ]
  },
  "schritte": [
    {
      "label": "Fehler-Einträge mit Grund-Code: nie gestartet, verweigert, älterer Eintrag ohne Code, unbekannter Code, Klärung nur mit Klartext",
      "warteAufSelector": {
        "selector": "#chat-verlauf [data-eintrag-art=\"fehler\"]",
        "timeoutMs": 8000
      },
      "screenshot": "01-fehler-gruende.webp"
    },
    {
      "label": "Ganzen Verlauf öffnen: alle Grund-Arten sichtbar",
      "klick": "#chat-ganzen-verlauf-link",
      "screenshot": "02-ganzer-verlauf.webp",
      "screenshotVollseite": true
    }
  ]
}
