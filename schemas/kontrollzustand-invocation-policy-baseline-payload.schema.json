{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workforce.local/schemas/kontrollzustand-invocation-policy-baseline-payload.schema.json",
  "title": "Invocation-Policy-Baseline (extern)",
  "description": "Struktur der Hash-Baseline für Werkzeugkonfiguration und Schutzskripte im externen Autorisierungs-Repository (F4, außerhalb dieses Produkt-Repos, D16-analog zu F3s kontrollzustand-autorisierung-payload.schema.json). Diese Schema-Definition liegt im Produkt-Repo, weil sie nur Struktur beschreibt — der Inhalt einer konkreten Baseline bleibt extern und wird nie hierher kopiert.",
  "type": "object",
  "additionalProperties": false,
  "required": ["werkzeug_konfiguration", "schutzskripte"],
  "properties": {
    "werkzeug_konfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pfad", "hash"],
      "properties": {
        "pfad": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    },
    "schutzskripte": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pfad", "hash"],
        "properties": {
          "pfad": { "type": "string", "minLength": 1 },
          "hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    },
    "erzeugt_am": { "type": "string", "minLength": 1 }
  }
}
